<?xml version="1.0" encoding="utf-8"?>
<!--
  Aucune source de paquets : la vérification doit se construire hors ligne, avec
  le seul SDK .NET. C'est aussi ce qui garantit que le code d'Assets/ ne dépend
  d'aucun paquet qu'Unity n'aurait pas.
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
