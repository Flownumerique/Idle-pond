/*
 * IdlePond — la mise en page de la mare. Les couleurs viennent de Theme.uss.
 *
 * L'écran mobile (spec du 2026-10-07) : une barre fine en haut, la mare au centre, le dock
 * en bas, et des tiroirs qui montent par-dessus la mare. Portrait d'abord ; en paysage
 * (`.paysage`, posé par RacineDeLInterface), la même chose, le tiroir à droite.
 *
 * Unités : le panneau est en « Scale With Screen Size », référence 1080 x 1920. La maquette
 * est dessinée pour un téléphone de 390 points de large : ses tailles sont multipliées par
 * 2,77 environ (390 → 1080). Le plancher de 48 px au doigt devient ~130 px ici.
 *
 * Propriétés USS volontairement évitées : pas de grille, pas d'espacement entre enfants,
 * pas de bordure en pointillés — seulement des boîtes flexibles et des marges.
 */

/* ─── Les tailles, par disposition ─────────────────────────────────────────────── */

.racine {
    flex-grow: 1;
    font-size: var(--t-base);
    color: var(--couleur-jour);
    background-color: var(--couleur-abysse);
    -unity-font: url("../Polices/Nunito-Regular.ttf");

    --t-xs: 20px;
    --t-sm: 22px;
    --t-base: 26px;
    --t-lg: 30px;
    --t-xl: 36px;
    --t-xxl: 48px;
    --h-bouton: 72px;
    --marge: 24px;
    --icone: 48px;
    --h-dock: 96px;
    --bas-du-dock: 14px;
    --haut-de-barre: 12px;
}

.portrait {
    --t-xs: 28px;
    --t-sm: 33px;
    --t-base: 39px;
    --t-lg: 44px;
    --t-xl: 55px;
    --t-xxl: 72px;
    --h-bouton: 122px;
    --marge: 44px;
    --icone: 66px;
    --h-dock: 166px;
    --bas-du-dock: 48px;
    --haut-de-barre: 20px;
}

/* ─── Le texte ──────────────────────────────────────────────────────────────────── */

.texte {
    margin: 0;
    padding: 0;
    color: var(--couleur-jour);
    font-size: var(--t-base);
    white-space: normal;
}

/* Tout ce qui se lit est en Nunito (consigne du 2026-10-07 : « les textes
   doivent être en une police lisible »). Les titres en gras ; les chiffres dans la même
   police que le texte qui les entoure. */
.titre {
    -unity-font: url("../Polices/Nunito-Bold.ttf");
}

.chiffre {
    -unity-font: url("../Polices/Nunito-Regular.ttf");
}

/* Les deux compteurs de la barre du haut, en gras : ils se lisent d'un coup d'œil. */
.barre-valeur,
.pastille-souffle > .chiffre {
    -unity-font: url("../Polices/Nunito-Bold.ttf");
}

.gras {
    -unity-font: url("../Polices/Nunito-Bold.ttf");
}

.italique {
    -unity-font-style: italic;
}

.xs { font-size: var(--t-xs); }
.sm { font-size: var(--t-sm); }
.base { font-size: var(--t-base); }
.lg { font-size: var(--t-lg); }
.xl { font-size: var(--t-xl); }
.xxl { font-size: var(--t-xxl); }

.doux { color: var(--couleur-jour-doux); }
.tu { color: var(--couleur-jour-tu); }
.mana { color: var(--couleur-mana); }
.souffle { color: var(--couleur-souffle); }
.souffle-doux { color: var(--couleur-souffle-doux); }
.densite { color: var(--couleur-densite); }
.trouble { color: var(--couleur-trouble); }

.sous-titre {
    margin-top: 18px;
    margin-bottom: 6px;
    letter-spacing: 2px;
}

/* ─── Les rangées ───────────────────────────────────────────────────────────────── */

.rangee {
    flex-direction: row;
    align-items: center;
}

.rangee > * {
    margin-right: 18px;
}

.rangee.entre {
    justify-content: space-between;
}

.rangee.entre > * {
    margin-right: 0;
}

.rangee.wrap {
    flex-wrap: wrap;
}

/* ─── La barre du haut ──────────────────────────────────────────────────────────── */

.barre {
    flex-shrink: 0;
    padding: var(--haut-de-barre) var(--marge) var(--haut-de-barre) var(--marge);
    background-color: var(--couleur-abysse);
    border-bottom-width: 2px;
    border-bottom-color: var(--couleur-bord);
}

.barre-haut {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.barre-mana {
    flex-direction: row;
    align-items: flex-end;
    flex-shrink: 1;
}

.barre-goutte {
    width: 54px;
    height: 54px;
    margin-right: 14px;
    align-self: center;
    color: var(--couleur-mana);
}

.barre-valeur {
    font-size: var(--t-xxl);
    margin-right: 20px;
}

.barre-debit {
    margin-bottom: 6px;
}

.pastille-souffle {
    flex-direction: row;
    align-items: center;
    padding: 8px 26px;
    border-width: 2px;
    border-radius: 60px;
    border-color: var(--couleur-souffle-bord);
    background-color: var(--couleur-souffle-fond);
}

.pastille-etincelle {
    width: 30px;
    height: 30px;
    margin-right: 12px;
    color: var(--couleur-souffle);
}

.pastille-souffle > .souffle-doux {
    margin-left: 12px;
}

.barre-jauge {
    margin: 18px 0 0 0;
}

/* ─── La mare, au centre ────────────────────────────────────────────────────────── */

.centre {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

/* Toute la place entre la barre et le dock. La texture du rendu pixel y est posée en
   fond par SceneDeLaMare ; ce fond couvre les moins de k pixels qui restent autour. */
.scene {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--couleur-abysse);
}

.lieu {
    position: absolute;
    left: 32px;
    top: 32px;
    flex-direction: row;
    align-items: center;
    padding: 14px 26px;
    border-radius: 20px;
    background-color: var(--abysse-75);
}

.lieu-profondeur {
    margin-left: 16px;
}

.retour {
    position: absolute;
    left: var(--marge);
    right: var(--marge);
    top: 140px;
}

.retour-ligne {
    padding: 18px 26px;
    border-width: 2px;
    border-color: var(--couleur-bord);
    border-radius: 20px;
    background-color: var(--fond-95);
}

.retour-ligne:hover {
    border-color: var(--couleur-clair);
}

/* Creuser plus bas : posé sur la mare, au-dessus du dock. */
.creuser {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 32px;
    align-items: center;
}

.creuser > .bouton {
    margin-top: 0;
    padding: 0 48px;
    border-width: 0;
    border-radius: 28px;
    background-color: var(--couleur-mana);
}

.creuser > .bouton .texte {
    color: var(--couleur-abysse);
}

.creuser > .bouton:hover {
    background-color: var(--couleur-jour);
}

.creuser > .bouton.inactif {
    opacity: 1;
    border-width: 2px;
    border-color: var(--couleur-clair);
    background-color: var(--abysse-75);
}

.creuser > .bouton.inactif .texte {
    color: var(--couleur-jour-doux);
}

/* ─── Les tiroirs ───────────────────────────────────────────────────────────────── */

.voile-du-tiroir {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--voile);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.26s;
}

.voile-du-tiroir.ouvert {
    opacity: 1;
}

.tiroir {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 78%;
    background-color: var(--couleur-fond);
    border-top-width: 2px;
    border-top-color: var(--couleur-bord);
    border-top-left-radius: 56px;
    border-top-right-radius: 56px;
    /* Le tiroir glisse depuis le bas ; la classe `ouvert` le pose (RacineDeLInterface). */
    translate: 0 100%;
    transition-property: translate;
    transition-duration: 0.26s;
    transition-timing-function: ease-out-cubic;
}

.tiroir.ouvert {
    translate: 0 0;
}

/* En paysage, le tiroir s'ouvre à droite, sur toute la hauteur de la mare. */
.paysage .tiroir {
    left: auto;
    top: 0;
    width: 46%;
    min-width: 640px;
    height: auto;
    border-top-width: 0;
    border-left-width: 2px;
    border-left-color: var(--couleur-bord);
    border-top-right-radius: 0;
    border-bottom-left-radius: 32px;
    translate: 100% 0;
}

.paysage .tiroir.ouvert {
    translate: 0 0;
}

.tiroir-tete {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 44px var(--marge) 20px var(--marge);
}

/* La poignée, centrée au bord du tiroir : elle dit qu'il se referme vers le bas. */
.tiroir-poignee {
    position: absolute;
    top: 18px;
    left: 50%;
    width: 100px;
    height: 11px;
    margin-left: -50px;
    border-radius: 6px;
    background-color: var(--couleur-clair);
}

.tiroir-titre {
    flex-shrink: 1;
}

.tiroir-fermer {
    width: 122px;
    height: 122px;
    justify-content: center;
    align-items: center;
    border-radius: 32px;
    background-color: var(--couleur-surface);
    color: var(--couleur-jour-doux);
}

.tiroir-fermer > .icone {
    width: 48px;
    height: 48px;
}

.defilement {
    flex-grow: 1;
}

.defilement .unity-scroll-view__content-container {
    padding: 0 var(--marge) 48px var(--marge);
}

/* ─── Le dock ───────────────────────────────────────────────────────────────────── */

.dock {
    flex-shrink: 0;
    flex-direction: row;
    padding: 12px 20px var(--bas-du-dock) 20px;
    background-color: var(--couleur-abysse);
    border-top-width: 2px;
    border-top-color: var(--couleur-bord);
}

.dock-bouton {
    flex-grow: 1;
    flex-basis: 0px;
    min-height: var(--h-dock);
    justify-content: center;
    align-items: center;
    margin: 0 6px;
    border-radius: 38px;
    color: var(--couleur-jour-doux);
    transition-property: background-color, scale;
    transition-duration: 0.15s;
}

/* Au doigt, le bouton s'enfonce un peu : le toucher a été entendu. */
.dock-bouton:active {
    scale: 0.92 0.92;
}

.dock-bouton:hover {
    background-color: var(--couleur-fond);
}

.dock-bouton.actif {
    background-color: var(--couleur-surface);
    color: var(--couleur-mana);
}

.dock-bouton.dock-dore {
    color: var(--couleur-souffle);
}

.dock-bouton > .icone {
    width: var(--icone);
    height: var(--icone);
}

/* L'icône hérite de la couleur du bouton ; le libellé, lui, est un `.texte`, qui pose la
   sienne : on la lui redonne, état par état. */
.dock-libelle {
    margin-top: 10px;
    color: var(--couleur-jour-doux);
    -unity-font: url("../Polices/Nunito-Bold.ttf");
    white-space: nowrap;
}

.dock-bouton.actif > .dock-libelle {
    color: var(--couleur-mana);
}

.dock-bouton.dock-dore > .dock-libelle {
    color: var(--couleur-souffle);
}

/* Accrochée au coin de l'icône, pas au bord du bouton : en paysage le bouton est large. */
.dock-pastille {
    position: absolute;
    top: 14px;
    left: 52%;
    min-width: 44px;
    height: 44px;
    padding: 0 10px;
    border-radius: 22px;
    background-color: var(--couleur-souffle);
    color: var(--couleur-souffle-fond);
    -unity-text-align: middle-center;
}

/* ─── Les cartes et les panneaux ────────────────────────────────────────────────── */

.carte {
    padding: 30px;
    margin-bottom: 24px;
    border-width: 2px;
    border-color: var(--couleur-bord);
    border-radius: 36px;
    background-color: var(--couleur-surface);
    transition-property: border-color;
    transition-duration: 1s;
}

.carte-souffle {
    border-color: var(--souffle-40);
    background-color: var(--couleur-souffle-fond);
}

.carte-claire {
    border-color: var(--couleur-clair);
    background-color: var(--couleur-fond);
}

/* L'eau trouble : un effet, pas un texte (GDD §2.4). */
.carte.eau-trouble {
    border-color: var(--trouble-50);
}

.panneau {
    margin-bottom: var(--marge);
}

.liste > .carte {
    margin-bottom: 24px;
}

/* ─── La jauge ──────────────────────────────────────────────────────────────────── */

.jauge {
    height: 22px;
    margin: 12px 0 6px 0;
    border-radius: 6px;
    background-color: var(--couleur-surface);
    overflow: hidden;
}

/* La part de la contenance que l'acquis de séjour ajoute : en fantôme, à droite. */
.jauge-fantome {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 0px;
    background-color: var(--mana-30);
}

.jauge-remplissage {
    height: 100%;
    width: 0px;
    border-radius: 6px;
    background-color: var(--couleur-mana);
    transition-property: width, background-color;
    transition-duration: 1s;
}

.jauge-remplissage.eau-trouble {
    background-color: var(--couleur-trouble);
}

.contenance-bloque {
    margin-top: 18px;
    padding-top: 18px;
    border-top-width: 1px;
    border-top-color: var(--couleur-bord);
}

.heros-bonus {
    margin-left: 6px;
}

/* ─── Les boutons ───────────────────────────────────────────────────────────────── */

.bouton {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    min-height: var(--h-bouton);
    margin-top: 18px;
    padding: 0 30px;
    border-width: 0;
    border-radius: 28px;
    background-color: var(--couleur-mana);
    overflow: hidden;
    transition-property: background-color, scale;
    transition-duration: 0.15s;
}

.bouton:active {
    scale: 0.97 0.97;
}

/* La part du prix déjà réunie, derrière le libellé : seulement tant qu'on ne peut pas payer.
   Payable, le bouton est plein de lui-même. */
.bouton-remplissage {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0px;
    display: none;
    background-color: var(--mana-30);
    transition-property: width;
    transition-duration: 0.3s;
}

.bouton.inactif > .bouton-remplissage {
    display: flex;
}

.bouton-souffle > .bouton-remplissage {
    background-color: var(--souffle-40);
}

.bouton .texte {
    color: var(--couleur-abysse);
}

.bouton:hover {
    background-color: var(--couleur-jour);
}

.bouton:active {
    background-color: var(--couleur-clair);
}

.bouton-cout {
    margin-left: 18px;
}

.bouton-souffle {
    background-color: var(--couleur-souffle);
}

.bouton-souffle:hover {
    background-color: var(--couleur-souffle-doux);
}

/* Un achat impossible reste visible, éteint : voir ce qu'on pourra acheter donne envie d'attendre. */
.bouton.inactif {
    border-width: 2px;
    border-color: var(--couleur-clair);
    background-color: var(--transparent);
}

.bouton.inactif .texte {
    color: var(--couleur-jour-doux);
}

.bouton.inactif:hover {
    background-color: var(--transparent);
}

.bouton-large {
    flex-grow: 1;
    margin-right: 12px;
}

.bouton-renaissance {
    border-width: 2px;
    border-color: var(--couleur-bord);
    background-color: var(--transparent);
}

.bouton-renaissance .texte {
    color: var(--couleur-jour-doux);
}

.bouton-renaissance.pressant {
    border-width: 0;
    background-color: var(--couleur-souffle);
}

.bouton-renaissance.pressant .texte {
    color: var(--couleur-souffle-fond);
}

.lien {
    min-height: 48px;
    justify-content: center;
    border-bottom-width: 1px;
    border-bottom-color: var(--couleur-clair);
}

.lien:hover {
    border-bottom-color: var(--couleur-jour);
}

.renaissance-lignes {
    margin: 12px 0;
}

/* ─── La table de captation ─────────────────────────────────────────────────────── */

.table-ligne {
    flex-direction: row;
    align-items: center;
    padding: 6px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--bord-60);
}

.table-pied {
    margin-top: 12px;
    border-bottom-width: 0;
}

.table-terme {
    flex-grow: 1;
    flex-basis: 0px;
}

.table-valeur {
    flex-grow: 1;
    flex-basis: 0px;
    -unity-text-align: upper-right;
}

.table-source {
    flex-grow: 1.4;
    flex-basis: 0px;
    padding-left: 12px;
    -unity-text-align: upper-right;
}

/* ─── Les succès ────────────────────────────────────────────────────────────────── */

.succes-acquis {
    padding: 14px 24px;
    margin-bottom: 10px;
    border-width: 2px;
    border-color: var(--couleur-clair);
    border-radius: 20px;
    background-color: var(--couleur-surface);
}

.succes-en-cours {
    padding: 14px 24px;
    margin-bottom: 10px;
    border-width: 2px;
    border-color: var(--couleur-bord);
    border-radius: 20px;
}

.succes-rail {
    height: 8px;
    margin-top: 12px;
    border-radius: 4px;
    background-color: var(--couleur-abysse);
    overflow: hidden;
}

.succes-barre {
    height: 100%;
    width: 0px;
    background-color: var(--couleur-souffle);
}

.puce {
    margin: 0 6px 6px 0;
    padding: 3px 9px;
    border-width: 1px;
    border-color: var(--couleur-bord);
    border-radius: 4px;
}

/* Un emplacement vide dit qu'il y a quelque chose là, pas quoi. */
.emplacement-vide {
    width: 30px;
    height: 30px;
    margin: 0 6px 6px 0;
    border-width: 1px;
    border-color: var(--bord-60);
    border-radius: 4px;
}

/* ─── Les annonces : une ligne qui apparaît et s'efface, jamais une fenêtre ───── */

.annonces {
    position: absolute;
    left: 0;
    right: 0;
    top: 140px;
    align-items: center;
    padding: 0 var(--marge);
}

.annonce {
    margin-top: 6px;
    padding: 12px 30px;
    border-width: 2px;
    border-color: var(--couleur-clair);
    border-radius: 30px;
    background-color: var(--fond-95);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.6s;
}

/* Une annonce est une phrase : pas de gras. */
.annonce.titre {
    -unity-font: url("../Polices/Nunito-Regular.ttf");
}

.annonce-visible {
    opacity: 1;
}

/* ─── Les tiroirs, révision 2 (maquette du 2026-10-07) ─────────────────────────── */

.tiroir-titres {
    flex-shrink: 1;
    flex-grow: 1;
    margin-right: 24px;
}

.tiroir-titres > .doux {
    margin-top: 4px;
}

/* Une vignette : le portrait d'un héros, d'une espèce, d'un œuf, dans un carré arrondi. */
.vignette {
    width: 122px;
    height: 122px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    border-radius: 28px;
    background-color: var(--couleur-abysse);
    color: var(--couleur-jour-doux);
}

.vignette > .icone {
    width: 72px;
    height: 72px;
}

.vignette-heros {
    width: 176px;
    height: 176px;
    border-radius: 36px;
    background-color: var(--couleur-surface);
    color: rgb(242, 199, 110);
}

.vignette-heros > .icone,
.vignette-oeuf > .icone {
    width: 120px;
    height: 120px;
}

.vignette-oeuf {
    width: 176px;
    height: 176px;
    border-radius: 36px;
    background-color: var(--couleur-souffle-fond);
    color: var(--couleur-souffle);
}

.fiche-tete {
    flex-direction: row;
    align-items: center;
    margin-bottom: 30px;
}

.fiche-noms {
    flex-shrink: 1;
    margin-left: 34px;
}

/* Deux tuiles par rangée : sans grille ni espacement en USS, des largeurs et des marges. */
.grille {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-bottom: 6px;
}

.tuile {
    width: 48.5%;
    margin-bottom: 24px;
    padding: 26px 30px;
    border-radius: 32px;
    background-color: var(--couleur-surface);
}

.tuile > .chiffre {
    margin-top: 8px;
}

.tuile-souffle {
    border-width: 2px;
    border-color: var(--couleur-souffle-bord);
    background-color: var(--couleur-souffle-fond);
}

/* ─── Les espèces, lieu par lieu ────────────────────────────────────────────────── */

.entete-de-lieu {
    flex-direction: row;
    align-items: center;
    margin: 12px 0 20px 0;
    padding: 24px 30px;
    border-width: 2px;
    border-radius: 32px;
    border-color: rgb(42, 78, 51);
    background-color: rgb(22, 48, 31);
    color: rgb(124, 196, 122);
}

.entete-de-lieu > .icone {
    width: 56px;
    height: 56px;
}

.entete-de-lieu-noms {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 24px;
}

.entete-de-lieu.verrouillee {
    border-color: var(--couleur-bord);
    background-color: rgb(18, 28, 30);
    color: var(--couleur-jour-tu);
}

.rangee-espece {
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
    padding: 26px;
    border-radius: 36px;
    background-color: var(--couleur-surface);
}

.rangee-espece > .vignette {
    margin-right: 28px;
}

.rangee-espece-infos {
    flex-grow: 1;
    flex-shrink: 1;
}

.rangee-espece-ligne {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 4px;
}

/* Une espèce qu'on n'atteint pas encore : grisée, sans nom, sans achat. */
.rangee-espece.verrouillee {
    background-color: rgb(18, 28, 30);
}

.rangee-espece.verrouillee > .vignette {
    color: var(--couleur-jour-tu);
}

.rail-de-seuil {
    height: 14px;
    margin: 14px 0 8px 0;
    border-radius: 4px;
    background-color: var(--couleur-abysse);
    overflow: hidden;
}

.rail-de-seuil-remplissage {
    height: 100%;
    width: 0px;
    background-color: var(--couleur-mana);
}

/* Le bouton d'une rangée : le verbe au-dessus du prix, à droite de la rangée. */
.bouton-compact {
    flex-direction: column;
    flex-shrink: 0;
    min-width: 200px;
    margin: 0 0 0 24px;
    padding: 14px 26px;
}

.bouton-compact > .bouton-cout {
    margin-left: 0;
    margin-top: 4px;
}

.lieu-a-venir {
    flex-direction: row;
    align-items: center;
    padding: 30px;
    border-width: 2px;
    border-radius: 32px;
    border-color: var(--couleur-bord);
    color: var(--couleur-jour-tu);
}

.lieu-a-venir > .icone {
    width: 48px;
    height: 48px;
    margin-right: 24px;
}

/* ─── L'œuf ─────────────────────────────────────────────────────────────────────── */

.deux-colonnes {
    flex-direction: row;
    margin: 18px 0 6px 0;
}

.colonne {
    width: 50%;
    padding-right: 20px;
}

.colonne > .texte {
    margin-bottom: 8px;
}

/* ─── Le Journal ────────────────────────────────────────────────────────────────── */

.journal-resume {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.journal-resume-texte {
    flex-shrink: 1;
}

.journal-rail {
    width: 200px;
    margin: 0 0 0 24px;
}

.journal-rail-remplissage {
    background-color: var(--couleur-souffle);
}

.filtres {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 24px;
}

.filtre {
    min-height: 100px;
    justify-content: center;
    margin: 0 16px 16px 0;
    padding: 0 38px;
    border-width: 2px;
    border-radius: 50px;
    border-color: var(--couleur-clair);
}

.filtre.actif {
    border-color: var(--couleur-souffle);
    background-color: var(--couleur-souffle);
}

.filtre.actif > .texte {
    color: var(--couleur-souffle-fond);
}

.grille-de-succes {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.carte-de-succes {
    width: 48.5%;
    align-items: center;
    margin-bottom: 24px;
    padding: 26px 22px;
    border-width: 2px;
    border-radius: 32px;
    border-color: var(--couleur-bord);
    background-color: var(--couleur-surface);
    color: var(--couleur-jour-tu);
}

.carte-de-succes > .icone {
    width: 72px;
    height: 72px;
    margin-bottom: 12px;
}

.carte-de-succes > .texte {
    -unity-text-align: upper-center;
    margin-bottom: 6px;
}

.carte-de-succes > .succes-rail {
    width: 100%;
}

.carte-de-succes.arrive {
    border-color: var(--couleur-souffle-bord);
    background-color: var(--couleur-souffle-fond);
    color: var(--couleur-souffle);
}

.carte-de-succes.en-chemin {
    color: var(--couleur-jour-doux);
}

.carte-de-succes.ferme,
.carte-de-succes.secret {
    background-color: rgb(18, 28, 30);
}

/* « 18 crans · » puis le débit : le lien ne colle pas au point médian. */
.rangee-espece-ligne > .lien {
    margin-left: 12px;
}

.renaissance-conseil {
    margin: 20px 0 30px 0;
}

/* En paysage, le libellé du dock passe à côté de l'icône : le dock garde une seule ligne,
   et la mare la hauteur qu'il ne prend plus. */
.paysage .dock-bouton {
    flex-direction: row;
}

.paysage .dock-libelle {
    margin-top: 0;
    margin-left: 14px;
}

/* En paysage, la pastille suit le libellé au lieu de flotter sur l'icône. */
.paysage .dock-pastille {
    position: relative;
    top: 0;
    left: 0;
    margin-left: 14px;
}
