<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!--
        La mare, en squelette. Tous les textes sont posés par les contrôleurs, depuis
        Textes.cs : ce fichier ne dit que la emplacement des panneaux, jamais ce qu'ils disent.
        L'adaptation (paysage ou portrait) est une classe posée sur #racine par
        RacineDeLInterface ; la mise en page est dans Mare.uss.
    -->
    <Style src="Theme.uss" />
    <Style src="Mare.uss" />
    <ui:VisualElement name="racine" class="racine">
        <ui:VisualElement name="entete" class="entete" />
        <ui:VisualElement name="retour" />
        <ui:VisualElement name="corps" class="corps">
            <ui:VisualElement name="principale" class="principale">
                <!-- Réservé à la scène dessinée : transparent, la caméra voit à travers. -->
                <ui:VisualElement name="scene" class="scene" picking-mode="Ignore" />
                <ui:ScrollView name="defilement" class="defilement">
                    <ui:VisualElement name="contenance" class="panneau" />
                    <ui:VisualElement name="heros" class="panneau" />
                    <ui:VisualElement name="captation" class="panneau" />
                    <ui:VisualElement name="mare" />
                    <ui:VisualElement name="renaissance" />
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement name="laterale" class="laterale">
                <ui:ScrollView name="defilement-lateral" class="defilement">
                    <ui:VisualElement name="succes" />
                    <ui:VisualElement name="insufflations" />
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="onglets" />
        <ui:VisualElement name="annonces" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
