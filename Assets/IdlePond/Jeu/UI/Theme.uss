/*
 * IdlePond — jetons visuels.
 *
 * Depuis l'écran mobile (spec du 2026-10-07), la palette est celle de la maquette de
 * l'utilisateur (canevas « IdlePond — Écran principal mobile ») : un sarcelle sombre, le
 * mana en turquoise clair, l'or pour le Souffle et l'œuf. Les noms des variables n'ont pas
 * changé ; leurs valeurs, si. La scène dessinée garde sa propre palette (Palette.cs).
 *
 *   --couleur-abysse     #0B1716   le fond, la barre et le dock
 *   --couleur-fond       #10211F   le tiroir
 *   --couleur-surface    #14302C   les cartes dans un tiroir
 *   --couleur-bord       #1E3532
 *   --couleur-clair      #35524D
 *   --couleur-jour       #E6EFEA
 *   --couleur-jour-doux  #9FB8B1
 *   --couleur-jour-tu    #7C948D
 *   --couleur-mana       #6FE0CF
 *   --couleur-souffle    #F0B54A   (et sa pastille : fond #2A2212, bord #5A4520)
 *   --couleur-densite    rgb(123, 181, 135)
 *   --couleur-trouble    rgb(157, 146, 108)
 *
 * L'eau qui se trouble — GDD §2.4 : la jauge s'éteint sans s'alarmer. Une couleur d'alerte
 * franche ferait de la seule pénalité douce du jeu un danger.
 *
 * Les variantes à opacité sont écrites en clair : USS ne sait pas dériver un alpha d'une
 * variable.
 *
 * Police (OFL, avec sa licence dans Jeu/Polices/) : Nunito pour tout ce qui s'affiche,
 * compteurs compris. Posée dans Mare.uss.
 */
.racine {
    --couleur-abysse: rgb(11, 23, 22);
    --couleur-fond: rgb(16, 33, 31);
    --couleur-surface: rgb(20, 48, 44);
    --couleur-bord: rgb(30, 53, 50);
    --couleur-clair: rgb(53, 82, 77);

    --couleur-jour: rgb(230, 239, 234);
    --couleur-jour-doux: rgb(159, 184, 177);
    --couleur-jour-tu: rgb(124, 148, 141);

    --couleur-mana: rgb(111, 224, 207);
    --couleur-souffle: rgb(240, 181, 74);
    --couleur-souffle-doux: rgb(217, 182, 119);
    --couleur-souffle-fond: rgb(42, 34, 18);
    --couleur-souffle-bord: rgb(90, 69, 32);
    --couleur-densite: rgb(123, 181, 135);
    --couleur-trouble: rgb(157, 146, 108);

    --fond-40: rgba(16, 33, 31, 0.4);
    --fond-50: rgba(16, 33, 31, 0.5);
    --fond-60: rgba(16, 33, 31, 0.6);
    --fond-95: rgba(16, 33, 31, 0.95);
    --abysse-75: rgba(8, 20, 18, 0.75);
    --voile: rgba(4, 10, 9, 0.55);
    --bord-60: rgba(30, 53, 50, 0.6);
    --mana-30: rgba(111, 224, 207, 0.3);
    --souffle-10: rgba(240, 181, 74, 0.1);
    --souffle-40: rgba(240, 181, 74, 0.4);
    --souffle-60: rgba(240, 181, 74, 0.6);
    --trouble-50: rgba(157, 146, 108, 0.5);
    --transparent: rgba(0, 0, 0, 0);
}
